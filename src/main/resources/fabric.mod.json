{
  "schemaVersion": 1,
  "id": "brigclient",
  "version": "${version}",
  "name": "Brig Client",
  "description": "Modern modular utility client for Minecraft 1.21.11. Optimization, Visuals, HUD, Cosmetics and Utilities.",
  "authors": [
    "Brig Team"
  ],
  "contact": {
    "homepage": "https://github.com/brigclient/brigclient",
    "sources": "https://github.com/brigclient/brigclient"
  },
  "license": "MIT",
  "icon": "assets/brigclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.brigclient.BrigClient"
    ]
  },
  "mixins": [
    "brigclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
